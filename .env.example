# .env.example — Template for environment variables.
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env    (Linux/macOS)
#   copy .env.example .env  (Windows)
#
# .env is git-ignored and must NEVER be committed to source control.
# In production (Docker / AWS EC2), inject these as real environment variables
# rather than using a .env file.
#
# All values shown here are the application defaults.
# You only need to override the ones you want to change.

# ── Flask ──────────────────────────────────────────────────────────────────────
# Generate a strong secret key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ── File uploads ───────────────────────────────────────────────────────────────
# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=50

# ── Document chunking ──────────────────────────────────────────────────────────
# chunk_size: characters per chunk (1000 ≈ 200 words).
# chunk_overlap: characters shared between consecutive chunks.
# These are starting values — adjust based on your document types.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ──────────────────────────────────────────────────────────────────
# Number of document chunks returned per similarity search.
TOP_K=4

# ── Embedding model ────────────────────────────────────────────────────────────
# Runs locally via HuggingFace sentence-transformers. No API key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector database ────────────────────────────────────────────────────────────
# Path where ChromaDB stores its data on disk.
# Use an absolute path when running inside Docker.
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=documents

# ── Local LLM (Ollama) ─────────────────────────────────────────────────────────
# LLM_PROVIDER: only "ollama" is supported in v1.
LLM_PROVIDER=ollama

# Model name. Must be pulled before first use:
#   ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# URL of the Ollama HTTP service.
# Local development:   http://localhost:11434
# Flask inside Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
